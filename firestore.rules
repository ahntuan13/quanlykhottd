rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function profilePath()   { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile()    { return signedIn() && exists(profilePath()); }
    function me()            { return get(profilePath()).data; }
    function active()        { return hasProfile() && me().active != false; }
    function isAdmin()       { return active() && me().role == 'admin'; }
    function canWrite()      { return active() && (me().role == 'admin' || me().role == 'keeper'); }
    function initialized()   { return exists(/databases/$(database)/documents/meta/init); }

    // Hồ sơ người dùng: mỗi người đọc được hồ sơ của mình, admin đọc/ghi tất cả.
    // Ngoại lệ: lần thiết lập đầu tiên (chưa có meta/init) cho phép tự tạo admin.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && !initialized() && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    match /meta/{doc} {
      allow read: if signedIn();
      allow create: if signedIn() && doc == 'init' && !initialized();
    }

    match /config/company { allow read: if active(); allow write: if isAdmin(); }
    match /config/seq     { allow read: if active(); allow write: if canWrite(); }

    match /warehouses/{id} { allow read: if active(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if active(); allow write: if canWrite(); }

    // Dữ liệu nghiệp vụ: thủ kho + admin được ghi, chỉ xem được đọc
    match /{col}/{id} {
      allow read:  if active() && col in ['items','receipts','issues','stocktakes','adjustments','assets','suppliers','retail','projects'];
      allow write: if canWrite() && col in ['items','receipts','issues','stocktakes','adjustments','assets','suppliers','retail','projects'];
    }
  }
}
